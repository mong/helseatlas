{
  "name": "oppdaterte-analyser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -o -e .env.local-db -- next dev",
    "dev:production-db": "dotenv -o -e .env.production-db -- next dev",
    "seed:local-db": "SEED_LOCAL_DOCKER_DB=1 dotenv -o -e .env.local-db -- payload run scripts/seed-local-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:types": "PAYLOAD_GENERATE_TYPES=true PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "generate:importmap": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap"
  },
